PORT=5000
# Neon pooled PostgreSQL connection string (keep the real value in .env only).
DATABASE_URL=postgresql://user:password@your-neon-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
# Generate a private 32-byte key and put its 64-character hex value here.
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
VAULT_ENCRYPTION_KEY=replace-with-64-hex-characters
# Set only when the frontend is on a different origin from the API.
CLIENT_ORIGIN=http://localhost:5173
# Optional external AI key. Never put secrets in VITE_ variables.
# GEMINI_API_KEY=your_key_here
# Optional model override. Default: gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite
